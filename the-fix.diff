diff --git a/validate-transaction.cbl b/validate-transaction.cbl
index 1a2b3c4..5d6e7f8 100644
--- a/validate-transaction.cbl
+++ b/validate-transaction.cbl
@@ -1,14 +1,10 @@
        VALIDATE-RECORD.
            MOVE TRAN-AMT TO WS-AMT-DISPLAY

